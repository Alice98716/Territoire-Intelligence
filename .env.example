# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# Required - MongoDB Atlas connection string (api_server.py / spatial_rag_v1.py
# raise at startup if this is missing).
MONGO_URI=

# Required - used by the Claude agent loop (api_server.py) and by
# test_pipeline_layer2/3/4/5.py. The Anthropic SDK raises immediately at
# client construction if this is unset.
ANTHROPIC_API_KEY=

# Optional - google_geocode_fallback in api_server.py degrades gracefully
# (falls back to Nominatim) if unset.
GOOGLE_MAPS_API_KEY=

# Optional - only used by test_geocodage.py's manual geocoder benchmark.
# Any provider left blank is skipped rather than failing the run.
MAPBOX_API_KEY=
GEOCODIO_API_KEY=
GEOAPIFY_API_KEY=

# Required locally - the app calls a local Ollama server (ChatOllama /
# OllamaEmbeddings) at http://127.0.0.1:11434 for the llama3.2:3b and
# nomic-embed-text models. Not an env var, but Ollama must be installed,
# running, and have both models pulled:
#   ollama pull llama3.2:3b
#   ollama pull nomic-embed-text
